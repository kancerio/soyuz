# Keep mock mode for local startup unless a local server is intentionally enabled.
AI_PROVIDER=mock

# LM Studio OpenAI-compatible server settings.
# AI_PROVIDER=lmstudio
AI_BASE_URL=http://127.0.0.1:1234/v1
AI_MODEL=
AI_API_KEY=lm-studio
AI_TIMEOUT_SECONDS=120
# Set to none for Qwen3.5 when the API should return the answer directly.
AI_REASONING_EFFORT=none
AI_MAX_TOKENS=512
AI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Speech-to-text provider. Keep mock for local startup, or point it to an
# OpenAI-compatible Whisper service for real transcription.
STT_PROVIDER=mock
STT_BASE_URL=http://127.0.0.1:9000/v1
STT_MODEL=whisper-1
STT_API_KEY=
STT_TIMEOUT_SECONDS=120
# Settings for tools/local_whisper_server.py when running local STT.
WHISPER_MODEL=Systran/faster-whisper-base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_PORT=9000
MAX_AUDIO_BYTES=26214400
MAX_SUMMARY_MESSAGES=100
