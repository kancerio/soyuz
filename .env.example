# AI Service Configuration
AI_ENVIRONMENT=development
AI_LOG_LEVEL=info
USE_LOCAL_MODELS=false

# AI service providers. Keep mock for local startup; switch explicitly on a stand.
AI_PROVIDER=mock
AI_BASE_URL=http://host.docker.internal:1234/v1
AI_MODEL=
AI_API_KEY=lm-studio
AI_TIMEOUT_SECONDS=120
STT_PROVIDER=mock
STT_BASE_URL=http://host.docker.internal:9000/v1
STT_MODEL=whisper-1
STT_API_KEY=
STT_TIMEOUT_SECONDS=120
MAX_AUDIO_BYTES=26214400
MAX_SUMMARY_MESSAGES=100

# External APIs (cloud)
YANDEX_CLOUD_API_KEY=
OPENAI_API_KEY=

# Security (optional)
API_KEY_REQUIRED=false
AI_API_KEY=

# Local models path (for on-prem)
LOCAL_MODELS_PATH=./models

# Database (for backend, optional)
DB_PASSWORD=secretpassword
DATABASE_URL=postgresql://messenger:${DB_PASSWORD}@postgres:5432/messenger_db

# Redis (for backend, optional)
REDIS_URL=redis://redis:6379
