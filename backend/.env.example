# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=messenger
DB_PASSWORD=secretpassword
DB_DATABASE=messenger_db

# JWT
JWT_SECRET=your_secret_key_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# HTTP API and frontend CORS
PORT=3001
FRONTEND_URL=http://localhost:3000

# WebSocket: разрешить авторизацию по userId без JWT и вход в любые комнаты (только для локального демо!)
# WS_ALLOW_INSECURE_AUTH=true

# AI service (AI_MOCK_MODE and model provider are configured in ai-service/.env)
AI_SERVICE_URL=http://localhost:8000
AI_REQUEST_TIMEOUT_MS=120000
AI_STT_TIMEOUT_MS=120000
